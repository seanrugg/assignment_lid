{{!
    @template assignsubmission_lid/no_analysis

    Template for displaying when no analysis exists.

    Context variables required for this template:
    * submissionid - The submission ID
    * cananalyze - Boolean, whether user can trigger analysis
}}

<div class="assignsubmission_lid_no_analysis">
    <div class="alert alert-info">
        <p>{{#str}}noanalysis, assignsubmission_lid{{/str}}</p>
        {{#cananalyze}}
        <button type="button" 
                class="btn btn-primary lid-analyze-button" 
                data-submissionid="{{submissionid}}">
            {{#str}}analyze, assignsubmission_lid{{/str}}
        </button>
        {{/cananalyze}}
    </div>
</div>
