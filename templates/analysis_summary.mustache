{{!
    @template assignsubmission_lid/analysis_summary

    Template for displaying LID analysis summary in grading view.

    Context variables required for this template:
    * hasanalysis - Boolean
    * overallquality - Quality score 0-100
    * cognitivedepth - Cognitive depth score 0-100
    * coherence - Coherence score 0-100
    * evidencequality - Evidence quality score 0-100
    * keystrengths - Array of strength strings
    * developmentpriorities - Array of development priority strings
    * topcompetencies - Array of top 3 competencies with name, bloom_level, bloom_label
    * analyzedat - Formatted timestamp
    * canreanalyze - Boolean
    * submissionid - Submission ID
}}

<div class="assignsubmission_lid_analysis_summary">
    <div class="lid-header">
        <h4>{{#str}}pluginname, assignsubmission_lid{{/str}}</h4>
        <small class="text-muted">{{#str}}analysiscompleted, assignsubmission_lid{{/str}} {{analyzedat}}</small>
    </div>

    <div class="lid-scores">
        <div class="row">
            <div class="col-md-3">
                <div class="lid-metric">
                    <span class="lid-metric-label">{{#str}}overallquality, assignsubmission_lid{{/str}}</span>
                    <span class="lid-metric-value">{{overallquality}}</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="lid-metric">
                    <span class="lid-metric-label">{{#str}}cognitivedepth, assignsubmission_lid{{/str}}</span>
                    <span class="lid-metric-value">{{cognitivedepth}}</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="lid-metric">
                    <span class="lid-metric-label">{{#str}}coherence, assignsubmission_lid{{/str}}</span>
                    <span class="lid-metric-value">{{coherence}}</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="lid-metric">
                    <span class="lid-metric-label">{{#str}}evidencequality, assignsubmission_lid{{/str}}</span>
                    <span class="lid-metric-value">{{evidencequality}}</span>
                </div>
            </div>
        </div>
    </div>

    {{#topcompetencies}}
    <div class="lid-competencies">
        <h5>{{#str}}topcompetencies, assignsubmission_lid{{/str}}</h5>
        <ul>
            {{#topcompetencies}}
            <li>
                <strong>{{competency_name}}</strong> 
                - {{bloom_label}} ({{#str}}bloomlevel, assignsubmission_lid{{/str}} {{bloom_level}})
            </li>
            {{/topcompetencies}}
        </ul>
    </div>
    {{/topcompetencies}}

    <div class="lid-feedback">
        <div class="row">
            <div class="col-md-6">
                <h5>{{#str}}keystrengths, assignsubmission_lid{{/str}}</h5>
                <ul>
                    {{#keystrengths}}
                    <li>{{{.}}}</li>
                    {{/keystrengths}}
                </ul>
            </div>
            <div class="col-md-6">
                <h5>{{#str}}developmentpriorities, assignsubmission_lid{{/str}}</h5>
                <ul>
                    {{#developmentpriorities}}
                    <li>{{{.}}}</li>
                    {{/developmentpriorities}}
                </ul>
            </div>
        </div>
    </div>

    <div class="lid-actions">
        <a href="#" class="btn btn-secondary">{{#str}}viewanalysis, assignsubmission_lid{{/str}}</a>
        {{#canreanalyze}}
        <button type="button" 
                class="btn btn-outline-primary lid-reanalyze-button" 
                data-submissionid="{{submissionid}}">
            {{#str}}reanalyze, assignsubmission_lid{{/str}}
        </button>
        {{/canreanalyze}}
    </div>
</div>
